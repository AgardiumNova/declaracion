<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Un verano extraño</title>

<style>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Montserrat:wght@300;400;500&display=swap');

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    :root {
        --cream: #f1e6c8;
        --summer: #e8b55b;
        --red: #8e302d;
        --dark-red: #421918;
        --forest: #18231d;
        --black: #080b09;
        --white: #fffaf0;
    }

    body {
        width: 100%;
        height: 100vh;
        overflow: hidden;
        background: var(--black);
        font-family: 'Montserrat', sans-serif;
        color: var(--white);
        cursor: crosshair;
    }

    /* =========================
       ESCENA
    ========================== */

    .scene {
        position: relative;
        width: 100%;
        height: 100vh;
        overflow: hidden;
        background:
            linear-gradient(
                to bottom,
                #d9a869 0%,
                #dbbd83 27%,
                #b9ad7b 42%,
                #53664c 69%,
                #17231d 100%
            );
    }

    .scene::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 20;
        pointer-events: none;
        background:
            radial-gradient(
                circle at center,
                transparent 20%,
                rgba(0,0,0,.05) 45%,
                rgba(0,0,0,.58) 115%
            );
    }

    /* textura */
    .grain {
        position: absolute;
        inset: -50%;
        width: 200%;
        height: 200%;
        opacity: .1;
        z-index: 21;
        pointer-events: none;

        background-image:
            url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='.55'/%3E%3C/svg%3E");

        animation: grain .2s steps(2) infinite;
    }

    @keyframes grain {
        0% { transform: translate(0,0); }
        25% { transform: translate(2%,-1%); }
        50% { transform: translate(-1%,2%); }
        75% { transform: translate(1%,1%); }
        100% { transform: translate(-2%,-1%); }
    }

    /* SOL */

    .sun {
        position: absolute;
        width: 170px;
        height: 170px;
        top: 8%;
        left: 14%;
        border-radius: 50%;
        background: #f4cf85;
        box-shadow:
            0 0 70px rgba(255,213,132,.7),
            0 0 160px rgba(255,185,76,.25);
        opacity: .75;
    }

    /* MONTAÑAS */

    .mountain {
        position: absolute;
        left: -10%;
        width: 120%;
        border-radius: 50% 50% 0 0;
    }

    .mountain.back {
        height: 42%;
        bottom: 24%;
        background: #72806a;
        clip-path: polygon(
            0 55%,
            10% 47%,
            17% 52%,
            26% 30%,
            35% 48%,
            45% 19%,
            55% 43%,
            66% 31%,
            78% 50%,
            89% 25%,
            100% 50%,
            100% 100%,
            0 100%
        );
        opacity: .82;
    }

    .mountain.front {
        height: 46%;
        bottom: 5%;
        background: #314832;
        clip-path: polygon(
            0 65%,
            9% 48%,
            16% 55%,
            25% 38%,
            33% 53%,
            45% 28%,
            53% 48%,
            64% 25%,
            75% 52%,
            84% 35%,
            92% 48%,
            100% 38%,
            100% 100%,
            0 100%
        );
    }

    /* HIERBA */

    .field {
        position: absolute;
        width: 100%;
        height: 40%;
        bottom: 0;
        z-index: 5;
        background: linear-gradient(
            to bottom,
            rgba(52,78,49,.6),
            #17261b 75%
        );
    }

    .grass {
        position: absolute;
        width: 2px;
        height: 40px;
        bottom: 0;
        background: #253a25;
        transform-origin: bottom;
        z-index: 6;
        animation: sway 3s ease-in-out infinite alternate;
    }

    @keyframes sway {
        from { transform: rotate(-5deg); }
        to { transform: rotate(8deg); }
    }

    /* POSTE */

    .pole {
        position: absolute;
        width: 11px;
        height: 55%;
        right: 19%;
        bottom: 25%;
        z-index: 4;
        background: #222a20;
        transform: rotate(1deg);
        box-shadow: 5px 0 4px rgba(0,0,0,.25);
    }

    .pole::before {
        content: "";
        position: absolute;
        width: 100px;
        height: 6px;
        left: -45px;
        top: 35px;
        background: #1d251d;
    }

    .wire {
        position: absolute;
        width: 55%;
        height: 130px;
        right: 18%;
        top: 24%;
        z-index: 3;
        border-top: 2px solid rgba(30,38,29,.8);
        border-radius: 50%;
        transform: rotate(-3deg);
    }

    /* TITULO */

    .intro {
        position: absolute;
        top: 9%;
        right: 8%;
        z-index: 30;
        text-align: right;
        max-width: 540px;
        pointer-events: none;
    }

    .small {
        font-size: .68rem;
        letter-spacing: .43rem;
        text-transform: uppercase;
        opacity: .65;
        margin-bottom: 10px;
    }

    h1 {
        font-family: 'Cormorant Garamond', serif;
        font-size: clamp(3rem,7vw,7rem);
        line-height: .78;
        font-weight: 500;
        text-shadow: 0 4px 20px rgba(0,0,0,.25);
    }

    h1 span {
        font-style: italic;
        color: var(--cream);
    }

    .subtitle {
        margin-top: 23px;
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.25rem;
        font-style: italic;
        opacity: .8;
    }

    /* OBJETO INTERACTIVO */

    .secret-container {
        position: absolute;
        left: 50%;
        bottom: 10%;
        z-index: 40;
        transform: translateX(-50%);
        text-align: center;
    }

    .secret {
        width: 135px;
        height: 135px;
        position: relative;
        margin: auto;
        cursor: pointer;
        border-radius: 50%;
        transition:
            transform .5s cubic-bezier(.175,.885,.32,1.275),
            filter .5s;
    }

    .secret:hover {
        transform: scale(1.12);
        filter: brightness(1.25);
    }

    .secret::before {
        content: "";
        position: absolute;
        inset: 17px;
        border-radius: 47% 53% 49% 51%;
        background:
            radial-gradient(
                circle at 40% 34%,
                #b8564d 0%,
                #80322e 31%,
                #391413 70%
            );
        animation: breathe 3s ease-in-out infinite;
        box-shadow:
            inset 0 0 22px #190707,
            0 0 40px rgba(112,31,27,.55);
    }

    .secret::after {
        content: "";
        position: absolute;
        inset: 0;
        border: 1px solid rgba(142,48,45,.7);
        border-radius: 46% 54% 48% 52%;
        animation: rotateBlob 9s linear infinite;
    }

    @keyframes breathe {
        0%,100% {
            transform: scale(.91);
        }
        50% {
            transform: scale(1.06);
        }
    }

    @keyframes rotateBlob {
        to {
            transform: rotate(360deg);
        }
    }

    .hint {
        font-family: 'Cormorant Garamond', serif;
        margin-top: 4px;
        font-size: 1rem;
        letter-spacing: .1rem;
        opacity: .65;
        transition: .5s;
    }

    .counter {
        margin-top: 5px;
        opacity: .35;
        font-size: .65rem;
        letter-spacing: .18rem;
        text-transform: uppercase;
    }

    /* MENSAJE PRINCIPAL */

    .reveal {
        position: fixed;
        inset: 0;
        z-index: 100;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;

        background:
            radial-gradient(
                circle at center,
                rgba(79,20,18,.35),
                rgba(3,5,4,.96)
            );

        opacity: 0;
        visibility: hidden;
        transition: opacity 1.4s ease;
        pointer-events: none;
    }

    .reveal.active {
        visibility: visible;
        opacity: 1;
        pointer-events: auto;
    }

    .reveal-message {
        position: relative;
        text-align: center;
    }

    .reveal .pre {
        text-transform: uppercase;
        font-size: .7rem;
        letter-spacing: .6rem;
        opacity: .5;
        margin-bottom: 25px;
    }

    .love {
        position: relative;
        font-family: 'Cormorant Garamond', serif;
        font-size: clamp(4rem,12vw,11rem);
        line-height: .9;
        font-weight: 500;
        color: var(--cream);
        text-shadow:
            0 0 30px rgba(200,90,75,.25),
            3px 3px 0 rgba(102,28,26,.65);
    }

    .love .sharon {
        display: block;
        font-style: italic;
        color: #c65d51;
    }

    .love::before,
    .love::after {
        content: "ME GUSTAS SHARON";
        position: absolute;
        left: 0;
        width: 100%;
        overflow: hidden;
        opacity: 0;
        pointer-events: none;
    }

    .love::before {
        top: 2px;
        color: #8b2222;
    }

    .love::after {
        top: -2px;
        color: #d7d097;
    }

    .reveal.active .love::before {
        animation: glitch1 4s infinite;
    }

    .reveal.active .love::after {
        animation: glitch2 4s infinite;
    }

    @keyframes glitch1 {
        0%,88%,100% {
            opacity: 0;
            transform: none;
        }
        89% {
            opacity: .6;
            transform: translate(-8px,2px);
            clip-path: inset(20% 0 55% 0);
        }
        91% {
            opacity: .2;
            transform: translate(5px,-2px);
            clip-path: inset(70% 0 10% 0);
        }
    }

    @keyframes glitch2 {
        0%,90%,100% {
            opacity: 0;
            transform: none;
        }
        91% {
            opacity: .45;
            transform: translate(9px,-3px);
            clip-path: inset(52% 0 22% 0);
        }
        92% {
            opacity: .25;
            transform: translate(-4px,1px);
        }
    }

    .confession {
        font-family: 'Cormorant Garamond', serif;
        max-width: 480px;
        margin: 32px 20px 0;
        font-size: 1.15rem;
        line-height: 1.7;
        opacity: 0;
        transform: translateY(15px);
        transition: 1.2s 1.1s;
        font-style: italic;
        color: #d8cfb9;
        text-align: center;
    }

    .reveal.active .confession {
        opacity: .75;
        transform: translateY(0);
    }

    .close {
        margin-top: 42px;
        border: 1px solid rgba(255,255,255,.2);
        background: transparent;
        color: rgba(255,255,255,.65);
        padding: 12px 28px;
        border-radius: 50px;
        cursor: pointer;
        letter-spacing: .14rem;
        text-transform: uppercase;
        font-size: .65rem;
        transition: .4s;
    }

    .close:hover {
        background: var(--cream);
        color: var(--black);
    }

    /* LUCIERNAGAS */

    .firefly {
        position: absolute;
        width: 3px;
        height: 3px;
        border-radius: 50%;
        background: #fff0a5;
        box-shadow: 0 0 10px #fff0a5;
        pointer-events: none;
        z-index: 18;
        animation:
            fireflyMove 8s linear infinite,
            flicker 2s ease-in-out infinite;
    }

    @keyframes flicker {
        0%,100% { opacity: .15; }
        50% { opacity: 1; }
    }

    @keyframes fireflyMove {
        0% {
            transform: translate(0,0);
        }
        30% {
            transform: translate(30px,-20px);
        }
        60% {
            transform: translate(-20px,-60px);
        }
        100% {
            transform: translate(5px,-100px);
        }
    }

    /* PARTÍCULAS ROJAS */

    .particle {
        position: fixed;
        border-radius: 50%;
        z-index: 110;
        pointer-events: none;
        background: #9d3933;
        box-shadow: 0 0 12px rgba(180,50,40,.75);
        animation: particleFly 2.8s forwards ease-out;
    }

    @keyframes particleFly {
        from {
            opacity: 1;
            transform: translate(0,0) scale(1);
        }
        to {
            opacity: 0;
            transform:
                translate(
                    var(--x),
                    var(--y)
                )
                scale(0);
        }
    }

    /* TEXTO VERTICAL */

    .vertical-text {
        position: absolute;
        left: 35px;
        top: 50%;
        transform: translateY(-50%);
        writing-mode: vertical-rl;
        letter-spacing: .35rem;
        font-family: 'Cormorant Garamond', serif;
        font-size: .82rem;
        opacity: .43;
        z-index: 30;
    }

    /* PANTALLA PALPITA */

    .heartbeat {
        animation: heartbeatScreen .45s;
    }

    @keyframes heartbeatScreen {
        0% { filter: none; }
        40% {
            filter:
                contrast(1.15)
                saturate(.75)
                brightness(.85);
        }
        100% { filter: none; }
    }

    /* RESPONSIVE */

    @media(max-width:700px) {

        .intro {
            right: 7%;
            top: 10%;
            left: 12%;
        }

        h1 {
            font-size: 3.7rem;
        }

        .sun {
            left: 8%;
            width: 120px;
            height: 120px;
        }

        .pole {
            right: 10%;
        }

        .vertical-text {
            left: 15px;
        }

        .secret-container {
            bottom: 9%;
        }

        .secret {
            width: 115px;
            height: 115px;
        }

        .love {
            font-size: 4rem;
        }
    }
</style>
</head>

<body>

<main class="scene" id="scene">

    <div class="grain"></div>

    <div class="sun"></div>

    <div class="mountain back"></div>
    <div class="mountain front"></div>

    <div class="pole"></div>
    <div class="wire"></div>

    <div class="field"></div>

    <div class="vertical-text">
        AQUEL VERANO ALGO CAMBIÓ
    </div>

    <header class="intro">

        <div class="small">
            una historia que nunca dije
        </div>

        <h1>
            El verano<br>
            que <span>recordaré</span>
        </h1>

        <p class="subtitle">
            Hay cosas que uno guarda demasiado tiempo.
        </p>

    </header>

    <section class="secret-container">

        <div
            class="secret"
            id="secret"
            title="Tócame"
        ></div>

        <p class="hint" id="hint">
            toca aquello que late
        </p>

        <p class="counter" id="counter">
            0 / 3
        </p>

    </section>

</main>


<!-- REVELACIÓN -->

<section class="reveal" id="reveal">

    <div class="reveal-message">

        <p class="pre">
            hay algo que quiero decirte
        </p>

        <h2 class="love">
            ME GUSTAS
            <span class="sharon">
                SHARON
            </span>
        </h2>

    </div>

    <p class="confession">
        Quizá este verano termine.<br>
        Quizá todo cambie.<br>
        Pero había algo que no quería seguir guardando.
    </p>

    <button class="close" id="close">
        volver al verano
    </button>

</section>


<script>

const scene = document.getElementById("scene");
const secret = document.getElementById("secret");
const hint = document.getElementById("hint");
const counter = document.getElementById("counter");

const reveal = document.getElementById("reveal");
const close = document.getElementById("close");

let clicks = 0;

/* ===========================
   GENERAR HIERBA
=========================== */

for(let i = 0; i < 120; i++){

    const grass = document.createElement("div");

    grass.classList.add("grass");

    grass.style.left =
        Math.random() * 100 + "%";

    grass.style.height =
        15 + Math.random() * 65 + "px";

    grass.style.opacity =
        .2 + Math.random() * .7;

    grass.style.animationDelay =
        Math.random() * 3 + "s";

    grass.style.transform =
        `rotate(${Math.random()*16-8}deg)`;

    scene.appendChild(grass);
}


/* ===========================
   LUCIÉRNAGAS
=========================== */

for(let i = 0; i < 27; i++){

    const f = document.createElement("div");

    f.classList.add("firefly");

    f.style.left =
        Math.random() * 100 + "%";

    f.style.top =
        45 + Math.random() * 50 + "%";

    f.style.animationDelay =
        Math.random() * 8 + "s";

    f.style.animationDuration =
        6 + Math.random() * 8 + "s";

    scene.appendChild(f);
}


/* ===========================
   SONIDO
=========================== */

let audioCtx;

function heartbeat(){

    try{

        if(!audioCtx){

            audioCtx =
                new (
                    window.AudioContext ||
                    window.webkitAudioContext
                )();
        }

        const osc =
            audioCtx.createOscillator();

        const gain =
            audioCtx.createGain();

        osc.type = "sine";

        osc.frequency.setValueAtTime(
            58,
            audioCtx.currentTime
        );

        gain.gain.setValueAtTime(
            0,
            audioCtx.currentTime
        );

        gain.gain.linearRampToValueAtTime(
            .32,
            audioCtx.currentTime + .02
        );

        gain.gain.exponentialRampToValueAtTime(
            .001,
            audioCtx.currentTime + .22
        );

        osc.connect(gain);

        gain.connect(
            audioCtx.destination
        );

        osc.start();

        osc.stop(
            audioCtx.currentTime + .25
        );

    }catch(e){}
}


/* ===========================
   INTERACCIÓN
=========================== */

const messages = [

    "¿Lo sentiste?",

    "otra vez...",

    "una última vez"

];


secret.addEventListener(
    "click",
    (event)=>{

        clicks++;

        heartbeat();

        scene.classList.remove(
            "heartbeat"
        );

        void scene.offsetWidth;

        scene.classList.add(
            "heartbeat"
        );

        secret.style.transform =
            "scale(1.25)";

        setTimeout(()=>{
            secret.style.transform = "";
        },250);

        if(clicks < 3){

            hint.textContent =
                messages[clicks - 1];

            counter.textContent =
                clicks + " / 3";

        }else{

            counter.textContent =
                "3 / 3";

            hint.textContent =
                "Sharon...";

            setTimeout(
                revealSecret,
                700
            );

        }

    }
);


/* ===========================
   REVELACIÓN
=========================== */

function revealSecret(){

    reveal.classList.add("active");

    heartbeat();

    setTimeout(
        heartbeat,
        210
    );

    createParticles();
}


/* ===========================
   PARTÍCULAS
=========================== */

function createParticles(){

    for(let i = 0; i < 75; i++){

        const particle =
            document.createElement("div");

        particle.classList.add(
            "particle"
        );

        const size =
            2 + Math.random()*6;

        particle.style.width =
            size + "px";

        particle.style.height =
            size + "px";

        particle.style.left =
            "50vw";

        particle.style.top =
            "50vh";

        particle.style.setProperty(
            "--x",
            (
                Math.random()*800 - 400
            ) + "px"
        );

        particle.style.setProperty(
            "--y",
            (
                Math.random()*700 - 350
            ) + "px"
        );

        particle.style.animationDelay =
            Math.random()*.8 + "s";

        document.body.appendChild(
            particle
        );

        setTimeout(()=>{
            particle.remove();
        },4000);
    }
}


/* ===========================
   CERRAR
=========================== */

close.addEventListener(
    "click",
    ()=>{

        reveal.classList.remove(
            "active"
        );

        clicks = 0;

        counter.textContent =
            "0 / 3";

        hint.textContent =
            "toca aquello que late";

    }
);


/* ===========================
   PARALLAX DEL RATÓN
=========================== */

document.addEventListener(
    "mousemove",
    (e)=>{

        const x =
            (e.clientX / innerWidth - .5);

        const y =
            (e.clientY / innerHeight - .5);

        document.querySelector(
            ".sun"
        ).style.transform =
            `translate(
                ${x * -18}px,
                ${y * -13}px
            )`;

        document.querySelector(
            ".mountain.back"
        ).style.transform =
            `translateX(${x * -8}px)`;

        document.querySelector(
            ".mountain.front"
        ).style.transform =
            `translateX(${x * -15}px)`;
    }
);

</script>

</body>
</html>
